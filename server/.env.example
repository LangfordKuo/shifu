# shifu-server 环境变量示例（复制为 .env 后修改）
# SQLite 起步；切换 MySQL 5.7 时改为：
#   provider = "mysql"（prisma/schema.prisma）
#   DATABASE_URL="mysql://user:pass@host:3306/shifu"
DATABASE_URL="file:./data/dev.db"

# JWT 签名密钥（生产环境务必更换为随机长字符串）
JWT_SECRET=change-me-to-a-random-64-hex-string
JWT_EXPIRES_IN=2h
REFRESH_TOKEN_EXPIRES_DAYS=7

# 服务端口
PORT=3000
