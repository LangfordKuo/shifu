# shifu-ai 环境变量示例（复制为 .env 后修改）
HOST=0.0.0.0
PORT=8000

# 推理设备: auto / cuda / cpu
DEVICE=auto

# 姿态模型路径（M2 起使用，可放 yolo11n-pose.pt / yolo26n-pose.pt）
MODEL_PATH=models/yolo11n-pose.pt

# CORS 允许来源，逗号分隔；* 表示全部
ALLOWED_ORIGINS=*

# 与 server/.env 的 JWT_SECRET 保持一致（WS 实时训练鉴权用）
JWT_SECRET=change-me-to-a-random-64-hex-string
